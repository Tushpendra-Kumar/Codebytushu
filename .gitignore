# ─────────────────────────────────────────────
#   CodeByTushu — .gitignore
# ─────────────────────────────────────────────

# Firebase (legacy — fully removed from project)
firebase-config.js
firebase-config.example.js

# Environment secrets (if ever added)
.env
.env.local
.env.*.local
*.env

# Database Backups (CRITICAL: Never commit data dumps)
/database/backups/*.sql
*.sqlite
*.db

# Node / npm (if ever used)
node_modules/
package-lock.json
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/settings.json
.idea/
*.suo
*.user

# Build output (if added later)
/dist/
/build/

# ─── PHP Infrastructure ──────────────────────
# PHP Composer
/vendor/
composer.lock
composer.phar

# Node.js (only used for dev scripts — no longer needed)
package.json
package-lock.json

# Uploaded user files (never commit)
/uploads/images/
/uploads/pdfs/
/uploads/videos/
/uploads/zips/
/uploads/misc/
/uploads/blog/
/uploads/courses/
/uploads/avatars/

# Maintenance flag
/private/.maintenance

# PHP error logs
*.log
error_log
